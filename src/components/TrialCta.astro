---
---

<section id="start-trial" class="relative overflow-hidden py-20">
	<div
		class="absolute inset-0 -z-10"
		style="background: radial-gradient(60% 80% at 50% 0%, rgba(245,158,11,0.16) 0%, transparent 70%)"
	>
	</div>
	<div class="mx-auto max-w-[900px] px-6">
		<div
			class="relative overflow-hidden rounded-3xl border border-zinc-200/70 bg-gradient-to-br from-zinc-950 via-zinc-900 to-zinc-950 px-8 py-14 text-center sm:px-14 shadow-[0_24px_60px_-16px_rgba(15,23,42,0.40),0_0_0_1px_rgba(15,23,42,0.10)]"
		>
			<div class="relative mx-auto max-w-[640px]">
				<h2 class="text-[38px] font-semibold tracking-[-0.025em] text-white leading-[1.1] sm:text-[46px]">
					Start your 7-day<br />free trial.<br />
					<span class="bg-gradient-to-r from-amber-300 to-orange-300 bg-clip-text text-transparent"
						>No card required.</span
					>
				</h2>
				<p class="mx-auto mt-5 max-w-[480px] text-[15px] leading-[1.65] text-zinc-300">
					One hosted dashboard for your whole team — unlimited projects and environments, durable
					execution history, and stale-job alerts. Try it free for 7 days.
				</p>

				<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
					<a
						href="https://app.deckapp.cloud/register"
						class="inline-flex items-center justify-center gap-2 rounded-xl bg-white px-5 py-3 text-[14px] font-semibold text-zinc-900 hover:bg-zinc-100 transition"
					>
						Start free trial →
					</a>
					<a
						href="/overview/"
						class="inline-flex items-center justify-center gap-2 rounded-xl bg-white/[0.07] px-5 py-3 text-[14px] font-semibold text-white ring-1 ring-inset ring-white/15 hover:bg-white/[0.12] transition"
					>
						Documentation
					</a>
				</div>

				<p class="mt-5 text-[12px] text-zinc-500">
					No credit card required. 7 days free, then $29/month.
				</p>
			</div>
		</div>
	</div>
</section>
