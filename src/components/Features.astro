---
import Icon from './Icon.astro';

const icons = {
	history: 'M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z',
	pause: 'M14.25 9v6m-4.5 0V9M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
	search: 'm21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z',
	shield:
		'M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z',
	alert: 'M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zM12 8.25v4.5m0 3h.008v.008H12v-.008z',
};

const tints = {
	orange: 'bg-orange-tint c-orange-ink',
	teal: 'bg-teal-tint c-teal',
	sun: 'bg-sun-tint c-ink',
};

const features = [
	{ icon: icons.history, tint: 'orange', title: 'Durable execution log', body: 'Every queue dispatch lands in your database with start, finish, status, attempt count, and tags. Outlasts Redis retention by months.' },
	{ icon: icons.pause, tint: 'teal', title: 'Cooperative cancel', body: 'Mark a job class Cancellable, drop a checkpoint between steps, and stop runaway work from the dashboard. No SIGTERM, no orphaned writes.' },
	{ icon: icons.search, tint: 'sun', title: 'Searchable activity', body: 'Filter by class, queue, connection, tag, or paste a UUID. The whole window of history is one search bar away, not a Redis dump.' },
	{ icon: icons.shield, tint: 'teal', title: 'Per-class blocking', body: 'Temporarily quiet a noisy job class for 1 hour, 24 hours, or until you say so. Workers pick the block up on the next attempt — no redeploy.' },
	{ icon: icons.alert, tint: 'orange', title: 'Stale-job alerts', body: "Subscribe per class: alert me if SyncInventory hasn't run in 24 hours. Deck checks on schedule and notifies through your existing Laravel channels." },
];
---

<section id="features" class="mx-auto max-w-[1180px] px-5 py-20">
	<div class="max-w-[640px]">
		<span class="pill bg-sun-tint c-ink">Under the hood</span>
		<h2 class="display mt-5 text-[40px] sm:text-[48px]">Built for the people on call.</h2>
		<p class="mt-4 text-[17px] leading-[1.6] c-soft">
			Deck is opinionated about one thing: <span class="font-bold c-ink">queues need a memory</span>.
			Every feature follows from that — and ships in the free package.
		</p>
	</div>

	<div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
		{
			features.map((f) => (
				<div class="card-b pop-sm p-6 transition-transform hover:-translate-y-1">
					<span class={`inline-flex size-12 items-center justify-center rounded-xl ${tints[f.tint]}`}>
						<Icon d={f.icon} size={22} strokeWidth={2} />
					</span>
					<h3 class="display mt-5 text-[21px]">{f.title}</h3>
					<p class="mt-2 text-[14.5px] leading-[1.55] c-soft">{f.body}</p>
				</div>
			))
		}
		<!-- CTA tile pointing at Cloud -->
		<a href="#cloud" class="card-b pop-sm bg-ink c-paper on-ink flex flex-col justify-between p-6 transition-transform hover:-translate-y-1">
			<span class="c-sun inline-flex size-12 items-center justify-center rounded-xl text-[22px] font-bold" style="background:rgba(245,158,11,0.14)">◆</span>
			<div class="mt-8">
				<h3 class="display text-[21px] c-paper">Run more than one app?</h3>
				<p class="mt-2 text-[14.5px] leading-[1.5] text-[color:var(--paper)]/80">Deck Cloud puts every project and environment on one dashboard <span class="c-sun">→</span></p>
			</div>
		</a>
	</div>
</section>
