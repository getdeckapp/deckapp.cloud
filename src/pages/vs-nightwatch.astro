---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import MoreComparisons from '../components/MoreComparisons.astro';
import TrialCta from '../components/TrialCta.astro';
import type { Row } from '../data/comparisons';

const title = 'Deck vs Laravel Nightwatch — Hosted App Monitoring vs Queue History & Controls';
const description =
	'Deck vs Nightwatch for Laravel queue monitoring. Hosted whole-app telemetry billed per event, or job history in your own database with cancel, block and alerts.';

// Nightwatch facts from its public site, docs and composer.json as of September 2026:
// hosted platform, per-event pricing with a free tier, 90-day default retention,
// PHP ^8.2 and Laravel 10–13 for the agent package. Pricing figures move, so the
// table describes the model rather than quoting numbers.
const rows: Row[] = [
	['Queue history', 'Per-execution job records: status, duration, exception', true, true],
	['Queue history', 'Works on any Laravel queue driver', true, true],
	['Queue history', 'Search & filter job execution history', true, true],
	['Queue history', 'Per-class stats and last-run time', true, 'Per-job performance views'],
	['Queue history', 'Live progress reported from inside a running job', true, 'Not documented'],
	['Queue history', 'Where the data lives', 'Your database, or Deck Cloud', 'Nightwatch’s hosted platform'],
	['Queue history', 'Retention', 'Whatever you set; months is normal', '90 days by default'],
	['Incident controls', 'Cooperative cancel of a job that is already running', 'Opt-in per class', false],
	['Incident controls', 'Block a single job class for 1h / 24h / until you say so', true, false],
	['Incident controls', 'Retry a failed execution from the dashboard', true, 'Not documented'],
	['Incident controls', 'Clear a pending queue backlog', true, false],
	['Alerts', '“Class X hasn’t run in 24h” alerts per job class', true, 'Alert rules on failures & thresholds'],
	['Alerts', 'Alert channels', 'Any Laravel notification channel', 'Built-in notification channels'],
	['Alerts', 'Shared incident history for the whole team', 'Deck Cloud', true],
	['Beyond queues', 'Requests, queries, exceptions, outgoing HTTP', false, true],
	['Beyond queues', 'Mail, notifications, cache, scheduler, commands, logs', false, true],
	['Pricing & deployment', 'Open source package', 'MIT, full dashboard included', 'MIT agent; the platform is hosted only'],
	['Pricing & deployment', 'Keep all data on your own infrastructure', true, false],
	['Pricing & deployment', 'Pricing model', 'Package free; Cloud is a flat team price', 'Free tier, then billed per event'],
	['Pricing & deployment', 'Hosted dashboard across many apps & environments', 'Deck Cloud', true],
	['Pricing & deployment', 'PHP & Laravel', 'PHP 8.3+, Laravel 11–13', 'PHP 8.2+, Laravel 10–13'],
];

const whyDeck = [
	['Your history stays yours', 'Deck writes every execution to your own database and keeps it as long as you decide. Nothing leaves your infrastructure unless you choose Deck Cloud.'],
	['Controls, not only telemetry', 'Cancel a running job cooperatively, block one noisy class for a day, retry a failure, clear a backlog. Nightwatch observes; Deck also acts.'],
	['Alerts that watch for silence', 'The costliest queue failure is the job that quietly stops being dispatched. Deck alerts per class when one hasn’t run on schedule.'],
	['A price that doesn’t track your traffic', 'The package is free. Deck Cloud is one flat price per team with a generous execution allowance, so a busy month doesn’t become a surprise invoice.'],
	['Small and self-contained', 'Precompiled CSS, no Livewire, no agent process to run. One composer require on any queue driver, with Horizon integration when you have it.'],
];

const whenNightwatch = [
	'You want one hosted, first-party view of requests, queries, exceptions, mail, cache and the scheduler alongside jobs.',
	'You prefer sending telemetry to a managed platform over storing it in your own database.',
	'Per-event pricing works for your traffic profile and you don’t need to cancel or block jobs from the dashboard.',
];
---

<MarketingLayout title={title} description={description}>
	<SiteHeader />

	<!-- ═══ hero ═════════════════════════════════════════════ -->
	<section class="warm-top">
		<div class="mx-auto max-w-[1180px] px-5 py-16 lg:py-24">
			<div class="max-w-[760px]">
				<span class="pill bg-teal-tint c-teal"><span class="size-2 rounded-full bg-teal"></span>Comparison</span>
				<h1 class="display mt-6 text-[48px] sm:text-[64px] lg:text-[72px]">
					Deck vs Nightwatch:<br />
					<span class="c-orange">your</span> database,<br />
					or theirs?
				</h1>
				<p class="mt-7 max-w-[640px] text-[18px] leading-[1.6] c-soft">
					<span class="font-bold c-ink">Laravel Nightwatch</span> is the first-party hosted
					monitoring platform: requests, queries, jobs, exceptions, mail and more, streamed to
					Laravel’s servers and billed per event. <span class="font-bold c-ink">Deck</span> is
					narrower and closer to home. It keeps every job execution in your own database, gives you
					the controls to cancel, block and retry, and alerts you when a class goes quiet. If the
					queue is what pages you, that depth and that ownership are the point.
				</p>
				<div class="mt-9 flex flex-wrap items-center gap-4">
					<a href="https://app.deckapp.cloud/register" class="btn btn-primary">Start 7-day free trial →</a>
					<a href="#compare" class="btn btn-paper">See the comparison</a>
				</div>
			</div>

			<div class="mt-12 grid gap-6 md:grid-cols-2">
				<div class="card-b pop-orange p-7">
					<span class="pill bg-orange-tint c-orange-ink">Deck</span>
					<h2 class="display mt-4 text-[26px]">A memory and a control panel for your queues.</h2>
					<p class="mt-3 text-[15px] leading-[1.6] c-soft">
						Deck is Laravel queue monitoring that lives in your own database. Every dispatch lands
						there with status, attempts, duration and tags, on any queue driver. From the same
						dashboard you cancel a running job, quiet a noisy class, retry a failure and get told when
						a class goes silent. Deck Cloud adds one hosted view across every app for a flat team
						price, and the package alone is free forever.
					</p>
				</div>
				<div class="card-b p-7">
					<span class="pill bg-teal-tint c-teal">Nightwatch</span>
					<h2 class="display mt-4 text-[26px]">First-party, hosted, whole-app monitoring.</h2>
					<p class="mt-3 text-[15px] leading-[1.6] c-soft">
						Nightwatch installs an agent that ships requests, jobs, queries, exceptions, mail, cache,
						scheduler and command telemetry to Laravel’s hosted platform, with dashboards, alerts and
						a default 90 days of retention. It is polished and deeply integrated with the framework.
						It is also observability only: it shows you jobs, it doesn’t act on them, and it bills
						by volume.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- ═══ compare ══════════════════════════════════════════ -->
	<section id="compare" class="mx-auto max-w-[1180px] px-5 py-20">
		<div class="max-w-[640px]">
			<span class="pill bg-sun-tint c-ink">Side by side</span>
			<h2 class="display mt-5 text-[40px] sm:text-[48px]">What each one does.</h2>
			<p class="mt-4 text-[17px] leading-[1.6] c-soft">
				A checkmark means the capability ships today. Where a plain yes or no would be misleading,
				the cell says what actually happens.
			</p>
		</div>

		<ComparisonTable competitor="Nightwatch" rows={rows} />

		<p class="mt-5 text-[13px] leading-[1.6] c-faint">
			Nightwatch capabilities are taken from its public site, documentation and package as of
			September 2026. Pricing tiers change, so the table describes the model rather than quoting
			figures. If something here is out of date,
			<a href="https://github.com/getdeckapp/deckapp.cloud/issues" target="_blank" rel="noopener" class="lnk c-soft">open an issue</a>
			and we’ll fix it.
		</p>

		<div class="card-b bg-sun-tint mt-10 flex flex-col items-start gap-5 p-7 sm:flex-row sm:items-center sm:justify-between">
			<div>
				<p class="display text-[22px]">Keep your job history where your data already lives.</p>
				<p class="mt-1.5 text-[14.5px] c-soft">The package is MIT and takes one composer require. Deck Cloud is free for 7 days, then flat per team.</p>
			</div>
			<div class="flex flex-wrap items-center gap-3">
				<a href="https://app.deckapp.cloud/register" class="btn btn-primary">Start free trial →</a>
				<a href="/package/getting-started/" class="btn btn-paper">Install the package</a>
			</div>
		</div>
	</section>

	<!-- ═══ which one ════════════════════════════════════════ -->
	<section class="bg-paper2 border-y border-[color:var(--border)]">
		<div class="mx-auto max-w-[1180px] px-5 py-20">
			<div class="max-w-[640px]">
				<span class="pill bg-orange-tint c-orange-ink">The honest answer</span>
				<h2 class="display mt-5 text-[40px] sm:text-[48px]">Breadth you rent, or depth you own.</h2>
				<p class="mt-4 text-[17px] leading-[1.6] c-soft">
					Nightwatch is the natural pick if you want one first-party place for everything. Deck is
					the pick if the thing that keeps hurting is a queue, and you’d rather hold the record
					yourself and be able to act on it. If you are weighing a Nightwatch alternative for queue
					work specifically, Deck is the narrower, self-owned option.
				</p>
			</div>

			<div class="mt-12 grid gap-6 lg:grid-cols-[1.15fr_0.85fr] lg:items-start">
				<div class="card-b pop-orange p-7">
					<h3 class="display text-[24px]">Why teams pick Deck</h3>
					<div class="mt-6 space-y-5">
						{whyDeck.map(([heading, body]) => (
							<div class="flex items-start gap-3">
								<span class="c-orange mt-0.5 font-bold">✓</span>
								<div>
									<p class="font-bold text-[15.5px]">{heading}</p>
									<p class="mt-1 text-[14.5px] leading-[1.55] c-soft">{body}</p>
								</div>
							</div>
						))}
					</div>
				</div>
				<div class="card-b p-7">
					<h3 class="display text-[24px]">When Nightwatch fits better</h3>
					<ul class="mt-6 space-y-3.5 text-[15px] leading-[1.55]">
						{whenNightwatch.map((f) => (
							<li class="flex items-start gap-2.5"><span class="c-teal font-bold">✓</span><span>{f}</span></li>
						))}
					</ul>
					<p class="mt-6 text-[14px] leading-[1.6] c-soft">
						Plenty of teams run Nightwatch for the application and Deck for the queue. They don’t
						compete for the same job; Deck simply keeps the copy you can act on.
					</p>
				</div>
			</div>
		</div>
	</section>

	<div class="pt-20">
		<MoreComparisons current="vs-nightwatch" />
	</div>

	<TrialCta />

	<SiteFooter />
</MarketingLayout>
